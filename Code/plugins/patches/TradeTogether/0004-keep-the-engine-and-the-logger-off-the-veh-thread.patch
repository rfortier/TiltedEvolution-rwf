+        //
+        // The producer side is multi-threaded (both exception handlers plus the
+        // resolver's flush worker plus RegisterListener's replay), so a slot is not
+        // "ready" merely because the write cursor moved past it: each slot carries a
+        // ticket that the producer publishes after copying, and the consumer only
+        // reads slots whose ticket matches the ticket it is expecting. Tickets are
+        // monotonically increasing rather than ring indices, so a wrapped slot is
+        // never mistaken for a fresh one.
+        // Bounded multi-producer / single-consumer queue (Vyukov). A plain
+        // single-writer ring is wrong here: the resolver reports from two vectored
+        // exception handlers, from its own one-second flush worker, and replays the
+        // whole table from RegisterListener on whichever thread called it.
+        //
+        // Every cell carries a sequence number that says whether it currently holds
+        // an event for the position the consumer is at. A producer therefore only
+        // claims a position after confirming the cell is free, so a full queue drops
+        // the event instead of leaving a claimed-but-unpublished position behind -
+        // that is what keeps a drop from stalling the drain forever.
+        struct PendingMappingCell
+        {
+            std::atomic<std::uint64_t> sequence{ 0 };
+            STRPM::ProxyMappingEvent event{};
+        };
+
+        static constexpr std::size_t kPendingMappingCapacity = 64;
+        std::array<PendingMappingCell, kPendingMappingCapacity> _pendingMappingCells{};
+        std::atomic<std::uint64_t> _pendingMappingEnqueue{ 0 };
+        std::atomic<std::uint64_t> _pendingMappingDequeue{ 0 };
+        std::atomic<std::uint32_t> _pendingMappingDropped{ 0 };
+
