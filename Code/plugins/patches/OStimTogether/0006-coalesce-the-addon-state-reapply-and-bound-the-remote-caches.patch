+
+        // FormIDs with a reapply pair in flight, and the time the guard for
+        // them expires. Both phases read the cache when they run, so one queued
+        // pair already covers every request made while it is pending. The last
+        // phase removes the entry; the expiry keeps a pair that was cut short
+        // (a save load) from blocking later requests forever.
+        std::unordered_map<
+            RE::FormID,
+            std::chrono::steady_clock::time_point>
+            _reapplyPending;
     };
 }
