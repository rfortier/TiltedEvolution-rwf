+    bool CoopSessionManager::IsAuthorizedMirrorSender(
+        STRPMApi::ConnectionID senderConnectionID,
+        std::int32_t ownerThreadID) const
+    {
+        if (senderConnectionID == 0) {
+            return false;
+        }
+
+        std::scoped_lock lock(_mutex);
+
+        // The mirror stream is addressed by the OWNER's thread id, which is the remote
+        // client's id - not one of ours. RouteOwnerPayload only ever forwards these
+        // packets from the client that owns the thread (it broadcasts to that
+        // session's participants), so the sender is the owner exactly when
+        // _mirrorByRemote holds a route under (sender, thread).
+        //
+        // The earlier version of this function fell back to _activeOwnerByThread, which
+        // is keyed by LOCAL thread ids. A remote owner id and a local thread id are both
+        // small integers, so that lookup could hit an unrelated local session and
+        // authorize a peer that never owned this mirror at all. There is no case in
+        // which the local table answers this question, so it is not consulted.
+        const auto routeIt = _mirrorByRemote.find(
+            MirrorKey(senderConnectionID, ownerThreadID));
+        if (routeIt == _mirrorByRemote.end()) {
+            return false;
+        }
+
+        // The sender owns the mirror. Whether it may still drive it is a question
+        // about the session, so the session is looked up when there is one and
+        // trusted when there is not: a mirror can exist without a coop session (free
+        // scenes), and refusing those would break a working path.
+        //
+        // The lookup goes through the LOCAL thread id the route recorded, because
+        // _activeOwnerByThread is keyed by our own ids while ownerThreadID belongs to
+        // the peer. Asking that table about a remote id would answer about an
+        // unrelated local thread.
+        const auto ownerIt = _activeOwnerByThread.find(routeIt->second);
+        if (ownerIt == _activeOwnerByThread.end()) {
+            return true;
+        }
+
+        const auto sessionIt = _ownerSessions.find(ownerIt->second);
+        if (sessionIt == _ownerSessions.end()) {
+            return true;
+        }
+
+        return sessionIt->second.active && !sessionIt->second.canceled;
+    }
