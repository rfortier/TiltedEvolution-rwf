+        static constexpr std::size_t kMaxResolvedEntries = 512;
+        static constexpr std::size_t kMaxRemoteNames = 512;
+
         // key = sender|thread|participantIndex (diagnostic/cache)
         std::unordered_map<std::string, RE::FormID> _resolved;
 
