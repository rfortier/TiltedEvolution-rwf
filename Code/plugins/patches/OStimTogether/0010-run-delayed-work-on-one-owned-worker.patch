+    void ParticipantAlignmentSync::StartDelayWorker()
+    {
+        if (_delayWorkerRunning.exchange(true)) {
+            return;
+        }
+
+        _delayWorker = std::jthread(
+            [this](std::stop_token token) {
+                DelayWorkerLoop(token);
+            });
+    }
+
+    void ParticipantAlignmentSync::StopDelayWorker()
+    {
+        if (!_delayWorkerRunning.exchange(false)) {
+            return;
+        }
+
+        if (_delayWorker.joinable()) {
+            _delayWorker.request_stop();
+            _delayWorker.join();
+        }
+
+        // Anything still pending refers to a scene that is already gone.
+        std::scoped_lock lock(_delayMutex);
+        _delayedTasks.clear();
+    }
+
+    void ParticipantAlignmentSync::ScheduleDelayed(
+        std::chrono::milliseconds delay,
+        std::function<void()> run)
+    {
+        if (!run) {
+            return;
+        }
+
+        {
+            std::scoped_lock lock(_delayMutex);
+            _delayedTasks.push_back(DelayedTask{
+                std::chrono::steady_clock::now() + delay,
+                std::move(run) });
+        }
+
+        StartDelayWorker();
+    }
+
+    void ParticipantAlignmentSync::DelayWorkerLoop(
+        std::stop_token stopToken)
+    {
+        // Poll interval bounds the timing error of a scheduled delay; the queue
+        // holds at most a handful of entries, so a full scan per tick is cheaper
+        // than keeping it ordered.
+        constexpr auto kPollInterval = std::chrono::milliseconds(10);
+
+        while (!stopToken.stop_requested() && _delayWorkerRunning.load()) {
+            std::this_thread::sleep_for(kPollInterval);
+
+            if (stopToken.stop_requested() || !_delayWorkerRunning.load()) {
+                break;
+            }
+
+            std::vector<DelayedTask> due;
+            {
+                std::scoped_lock lock(_delayMutex);
+                const auto now = std::chrono::steady_clock::now();
+                for (auto it = _delayedTasks.begin(); it != _delayedTasks.end();) {
+                    if (now >= it->due) {
+                        due.push_back(std::move(*it));
+                        it = _delayedTasks.erase(it);
+                    } else {
+                        ++it;
+                    }
+                }
+            }
+
+            if (due.empty()) {
+                continue;
+            }
+
+            // Everything the callbacks touch is OStim/game state, so they are
+            // handed to the game thread exactly as the detached threads did.
+            auto* tasks = SKSE::GetTaskInterface();
+            if (!tasks) {
+                continue;
+            }
+
+            tasks->AddTask([this, items = std::move(due)]() mutable {
+                if (!_delayWorkerRunning.load()) {
+                    return;
+                }
+                for (auto& item : items) {
+                    if (item.run) {
+                        item.run();
+                    }
+                }
+            });
+        }
+    }
