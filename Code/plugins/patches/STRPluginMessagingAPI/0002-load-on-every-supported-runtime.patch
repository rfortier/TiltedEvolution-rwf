+// SKSE 2.0.x (1.5.97) requires BOTH SKSEPlugin_Query and SKSEPlugin_Load, and
+// logs "does not appear to be an SKSE plugin" when either is missing. This file
+// only ever exported Load, so on 1.5.97 the bridge was skipped outright - that
+// log line is in this repository's own 1.5.97 skse64.log.
+//
+// Query is a no-op returning true, matching the API facade: the gate that
+// matters on 1.5.97 is CheckPluginCompatibility, and returning false here would
+// reject the plugin before Load ever runs.
+extern "C" __declspec(dllexport) bool SKSEPlugin_Query(
+    const STRPMSKSE::SKSEInterface*,
+    STRPMSKSE::PluginInfo* apInfo)
+{
+    if (apInfo == nullptr) {
+        return false;
+    }
+
+    apInfo->infoVersion = STRPMSKSE::kPluginInfoVersion;
+    apInfo->name = "STRPluginMessagingBridge";
+    apInfo->version = STRPMSKSE::kPluginVersion_0_9_3;
+    return true;
+}
