+        std::uint32_t infoVersion;
+        const char* name;
+        std::uint32_t version;
+    };
+
+    inline constexpr std::uint32_t kPluginInfoVersion = 1;
+
+    // versionIndependence flags, from SKSE64's PluginAPI.h.
+    //
+    // The facade declares version independence rather than a runtime list. It
+    // resolves everything by signature and anchor scanning - it includes no
+    // game header, names no RE:: type and contains no absolute address - so
+    // there is no address-library or structure dependency for SKSE to check.
+    //
+    // Listing runtimes is what the previous revision did, with 1.6.1170 alone.
+    // SKSE 2.2.x matches that list against the exact running RUNTIME_VERSION,
+    // so every other runtime the package ships libraries for - 1.6.640,
+    // 1.6.1179 and the whole 1.7.x line - answered "disabled, incompatible
+    // with current version of the game".
+    inline constexpr std::uint32_t kVersionIndependent_Signatures = 1 << 1;
+    inline constexpr std::uint32_t kVersionIndependentEx_NoStructUse = 1 << 0;
+
