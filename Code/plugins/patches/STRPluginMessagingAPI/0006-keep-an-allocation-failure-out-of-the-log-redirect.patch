         {
-            std::filesystem::path logDirectory(documents);
-            CoTaskMemFree(documents);
+            // This function stands in for fopen_s through the macro at the bottom of
+            // this file, so a caller reads it as a C runtime call and cannot handle a
+            // throw. It is also declared noexcept, and the filesystem operations below
+            // are the only allocating steps in it, so an allocation failure would
+            // terminate the game process here with no crash dump. The log helpers that
+            // reach it are noexcept as well and they run on every single log line, so
+            // none of them could report the failure either. Falling through to the
+            // plain lookup below is what the code already does when the log directory
+            // cannot be built at all.
+            try
+            {
+                std::filesystem::path logDirectory(documents);
+                CoTaskMemFree(documents);
+                documents = nullptr;
 
-            logDirectory /= L"My Games";
-            logDirectory /= L"Skyrim Special Edition";
-            logDirectory /= L"SKSE";
+                logDirectory /= L"My Games";
+                logDirectory /= L"Skyrim Special Edition";
+                logDirectory /= L"SKSE";
 
-            std::error_code error;
-            std::filesystem::create_directories(logDirectory, error);
-            if (!error)
-            {
-                const auto logPath = logDirectory / L"STRPluginMessagingBridge.log";
+                std::error_code error;
+                std::filesystem::create_directories(logDirectory, error);
+                if (!error)
+                {
+                    const auto logPath = logDirectory / L"STRPluginMessagingBridge.log";
 
-                wchar_t wideMode[8]{};
-                if (mode != nullptr) {
-                    std::size_t index = 0;
-                    for (; mode[index] != '\0' && index + 1 < std::size(wideMode); ++index)
-                        wideMode[index] = static_cast<wchar_t>(static_cast<unsigned char>(mode[index]));
-                    wideMode[index] = L'\0';
-                }
-                if (wideMode[0] == L'\0') {
-                    wideMode[0] = L'a';
-                    wideMode[1] = L'\0';
-                }
+                    wchar_t wideMode[8]{};
+                    if (mode != nullptr) {
+                        std::size_t index = 0;
+                        for (; mode[index] != '\0' && index + 1 < std::size(wideMode); ++index)
+                            wideMode[index] = static_cast<wchar_t>(static_cast<unsigned char>(mode[index]));
+                        wideMode[index] = L'\0';
+                    }
+                    if (wideMode[0] == L'\0') {
+                        wideMode[0] = L'a';
+                        wideMode[1] = L'\0';
+                    }
 
-                const auto result = _wfopen_s(file, logPath.c_str(), wideMode);
-                if (result == 0)
-                    return 0;
+                    const auto result = _wfopen_s(file, logPath.c_str(), wideMode);
+                    if (result == 0)
+                        return 0;
+                }
+            }
+            catch (...)
+            {
             }
+
+            if (documents != nullptr)
+                CoTaskMemFree(documents);
         }
     }
 
