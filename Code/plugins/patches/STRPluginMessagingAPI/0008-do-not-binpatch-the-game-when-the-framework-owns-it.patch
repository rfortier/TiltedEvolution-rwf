diff --git a/src/STRPMFrameworkRuntime.h b/src/STRPMFrameworkRuntime.h
new file mode 100644
index 0000000..f97926f
--- /dev/null
+++ b/src/STRPMFrameworkRuntime.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <Windows.h>
+
+// Shared by every resolver in this bridge that finds the STR runtime by scanning
+// memory for its string anchors and then patches what it finds.
+//
+// Skyrim Together Next's own runtime exports the same transport and
+// proxy-resolver queries this bridge exists to answer - STRPM_QueryTransportInterface
+// and STR_QueryPluginMessagingProxyResolver - and answers them from its own
+// components (see Code/client/Services/PluginMessagingExport.cpp and
+// Code/plugins/patches/STRPluginMessagingAPI/0001-prefer-the-framework-transport.patch).
+// When it is mapped, the facade prefers it and this bridge is not the transport.
+//
+// That matters here because the framework runtime is a *different image* that
+// carries the *same* chat anchor strings. A resolver that scans while it is
+// mapped finds those anchors inside the framework's own code, resolves an xref
+// to them, and then treats the function it landed in as STR 1.8.0's
+// TransportService::Send - which it is not. The result is not a no-op: the
+// capture breakpoint writes 0xCC over a live function of the running framework,
+// and the call step-over controller sets the Trap Flag on threads executing it.
+// Both are crashes, and both happen at whatever the game was doing.
+//
+// GetModuleHandleW only, never LoadLibraryW: the runtime has one name per game
+// version family and the two are different ABIs, so loading a name that merely
+// exists on disk would pull a cross-ABI image into the process. This mirrors the
+// facade's own probe of these two names.
+//
+// Checked at the point of use rather than once at load, because SKSE's plugin
+// load order is not ours to choose: the facade that starts these resolvers and
+// the bootstrap that deploys the runtime are separate DLLs in the same
+// directory, so either can run first. A per-use check is correct in both orders.
+inline bool STRPMFrameworkRuntimeIsMapped() noexcept
+{
+    return GetModuleHandleW(L"SkyrimTogetherRuntime.dll") != nullptr ||
+           GetModuleHandleW(L"SkyrimTogetherRuntime_1_5.dll") != nullptr;
+}
