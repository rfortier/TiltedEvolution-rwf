+        // Inside Skyrim Together Next the framework runtime exports the same
+        // four entry points as this facade and answers them over its own
+        // session. Every companion plugin loads this facade by name, so probing
+        // for the framework here is what puts them on a transport that can
+        // actually receive: the configured bridge's receive resolver scans
+        // SkyrimSE.exe's own allocation only, while this framework's
+        // TransportService lives in a separate module, so the bridge stays
+        // permanently unready and every send() returns kNotConnected.
+        //
+        // GetModuleHandleW only, never LoadLibraryW. The runtime has one name
+        // per game-version family and the two are different ABIs, so loading a
+        // name that is merely present on disk would pull a cross-ABI image into
+        // the process. A runtime that is not already loaded is not ours to use.
+        static HMODULE GetLoadedFrameworkRuntime()
+        {
+            for (const auto* name : { L"SkyrimTogetherRuntime.dll",
+                                      L"SkyrimTogetherRuntime_1_5.dll" }) {
+                if (const auto module = GetModuleHandleW(name);
+                    module != nullptr) {
+                    return module;
+                }
+            }
+
+            return nullptr;
+        }
+
