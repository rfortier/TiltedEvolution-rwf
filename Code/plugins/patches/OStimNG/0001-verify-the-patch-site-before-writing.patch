 namespace GameLogic {
     void installHooks();
     void installHooksPostPost();
+
+    // write_call<5> / write_branch<5> overwrite exactly five bytes, so a site
+    // is only safe to patch when it starts with a five-byte rel32 branch. The SE
+    // and AE offsets differ, and on 1.5.80/1.5.97 the SE GetHeading offset lands
+    // inside a six-byte FF /2 indirect call instead of on a call: patching there
+    // splits the instruction, leaves the last byte of its disp32 as an orphan
+    // tail, and computes the "original" target from the middle of that
+    // displacement. Skipping is the correct outcome - a wrong hook corrupts the
+    // instruction stream on every call.
+    inline bool patchSiteIsRel32Branch(std::uintptr_t a_site, std::uint8_t a_opcode) {
+        return *reinterpret_cast<const std::uint8_t*>(a_site) == a_opcode;
+    }
 
