diff --git a/skse/src/Util/MainThread.h b/skse/src/Util/MainThread.h
new file mode 100644
index 0000000..c2f50f1
--- /dev/null
+++ b/skse/src/Util/MainThread.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <windows.h>
+
+namespace Util {
+    // The thread SKSEPlugin_Load() runs on, which is the game's main thread.
+    //
+    // Several subsystems complete their work by dispatching through SKSE's task
+    // interface, and that queue is drained by the main thread. A caller that waits
+    // for such a completion while already running on the main thread is therefore
+    // waiting for itself: the queued task cannot run until the wait returns. That
+    // makes "am I on the main thread" the deciding question before any such wait,
+    // so the id is captured once at load time instead of being guessed per call.
+    inline DWORD g_mainThreadId = 0;
+
+    inline void RecordMainThread() noexcept { g_mainThreadId = ::GetCurrentThreadId(); }
+
+    // False until RecordMainThread() has run, so a caller that cannot tell must not
+    // treat itself as the main thread and block.
+    inline bool IsMainThread() noexcept { return g_mainThreadId != 0 && ::GetCurrentThreadId() == g_mainThreadId; }
+}
