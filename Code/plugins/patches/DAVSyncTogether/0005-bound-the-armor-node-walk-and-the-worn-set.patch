+    bool DAVProbe::VisitArmorNodes(RE::NiAVObject* object, ActiveAddonMap& activeAddons)
+    {
+        // The player's 3D graph is engine-owned and this walk runs on every probe
+        // tick, so one walk is bounded instead of trusting the graph's depth. The
+        // result says whether the whole graph was seen: a partial walk would report
+        // armor addons as missing and ClassifyVisualState would then publish a visual
+        // state that is wrong rather than merely incomplete.
+        std::size_t budget = kMaxVisitNodes;
+        bool exhausted = false;
+        VisitArmorNodesRecursive(object, activeAddons, 0, budget, exhausted);
+        return !exhausted;
+    }
