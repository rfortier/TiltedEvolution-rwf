diff --git a/src/SyncService.cpp b/src/SyncService.cpp
index 1b45949..99a45b6 100644
--- a/src/SyncService.cpp
+++ b/src/SyncService.cpp
@@ -259,6 +259,15 @@ namespace IEDSyncTogether
         bool characterChanged = false;
         {
             std::scoped_lock lock(_snapshotMutex);
+            if (!_remoteSnapshots.contains(*instanceID) &&
+                _remoteSnapshots.size() >= kMaxRemoteSnapshots) {
+                SKSE::log::warn(
+                    "Remote IED state dropped: peer table full size={} peer={}",
+                    _remoteSnapshots.size(),
+                    *instanceID);
+                return;
+            }
+
             auto& snapshot = _remoteSnapshots[*instanceID];
             characterChanged = !snapshot.characterName.empty() &&
                                snapshot.characterName != *sender;
diff --git a/src/SyncService.h b/src/SyncService.h
index c0bf8fe..b068ae1 100644
--- a/src/SyncService.h
+++ b/src/SyncService.h
@@ -53,6 +53,12 @@ namespace IEDSyncTogether
         std::uint64_t _revision{ 0 };
         std::chrono::steady_clock::time_point _lastSend{};
         mutable std::mutex _snapshotMutex;
+
+        // The peer id is a field the sender fills in, and nothing ever erases
+        // an entry, so the table is bounded here. A full table drops the
+        // packet instead of growing without limit.
+        static constexpr std::size_t kMaxRemoteSnapshots = 64;
+
         std::unordered_map<std::string, RemoteSnapshot> _remoteSnapshots;
         std::unordered_set<RE::FormID> _blockedProxies;
     };
