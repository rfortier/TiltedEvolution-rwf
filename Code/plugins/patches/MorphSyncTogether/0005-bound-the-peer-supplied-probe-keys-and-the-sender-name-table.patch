diff --git a/src/AppearanceProbe.h b/src/AppearanceProbe.h
index 99d9684..4786079 100644
--- a/src/AppearanceProbe.h
+++ b/src/AppearanceProbe.h
@@ -169,6 +169,15 @@ namespace MorphSyncTogether
         std::uint32_t _materialRebindFollowups{ 3 };
         std::uint32_t _materialRebindIntervalMs{ 1000 };
 
+        // The key is built from a display name the remote peer supplies and the
+        // transient proxy FormID it is attached to, and nothing removes an entry
+        // once it is written, so both tables are bounded here. A key longer than
+        // the probe accepts can never be matched again, and a full table drops
+        // the sample instead of growing without limit.
+        static constexpr std::size_t kMaxProbeKeyBytes = 256;
+        static constexpr std::size_t kMaxProbeSnapshots = 256;
+        static constexpr std::size_t kMaxAppearanceCaches = 128;
+
         mutable std::mutex _stateMutex;
         std::unordered_map<std::string, Snapshot> _snapshots;
         std::unordered_map<std::string, AppearanceCache> _appearanceCaches;
