+++ b/package/Data/SKSE/Plugins/MorphSyncTogether.ini
@@ -29,7 +29,10 @@ Enabled=1
 [AppearanceProbe]
 Enabled=1
 IntervalMs=1000
-Verbose=1
+; 1 lists every probed node, tint and overlay on each appearance change. It is
+; off by default: one probe emits up to 45 lines, and each of them used to be
+; written to disk on the game thread for data nobody reads.
+Verbose=0
 
 [AppearancePreserve]
 Enabled=1
