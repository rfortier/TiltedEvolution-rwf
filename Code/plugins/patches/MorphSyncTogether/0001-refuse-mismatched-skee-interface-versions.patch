diff --git a/src/AppearanceProbe.cpp b/src/AppearanceProbe.cpp
index e55de99..7b1ca6b 100644
--- a/src/AppearanceProbe.cpp
+++ b/src/AppearanceProbe.cpp
@@ -387,11 +387,34 @@ namespace MorphSyncTogether
 
         std::scoped_lock lock(_interfaceMutex);
 
+        // QueryInterface answers by name, not by layout, so an older RaceMenu
+        // hands back an interface whose vtable does not match this build's
+        // declaration. GetVersion() is slot 1 in every layout, so it is safe to
+        // ask before touching anything else.
         if (auto* base = interfaceMap->QueryInterface("Overlay")) {
-            _overlay = static_cast<SKEE::IOverlayInterface*>(base);
+            auto* candidate = static_cast<SKEE::IOverlayInterface*>(base);
+            if (candidate->GetVersion() >= SKEE::IOverlayInterface::kSupportedVersion) {
+                _overlay = candidate;
+            } else {
+                SKSE::log::error(
+                    "MST APPEARANCE Overlay interface version {} is older than the {} this build "
+                    "declares; leaving it disabled because the vtable layout differs and calling "
+                    "it would dispatch to the wrong methods. Update RaceMenu.",
+                    candidate->GetVersion(),
+                    SKEE::IOverlayInterface::kSupportedVersion);
+            }
         }
         if (auto* base = interfaceMap->QueryInterface("Override")) {
-            _override = static_cast<SKEE::IOverrideInterface*>(base);
+            auto* candidate = static_cast<SKEE::IOverrideInterface*>(base);
+            if (candidate->GetVersion() >= SKEE::IOverrideInterface::kSupportedVersion) {
+                _override = candidate;
+            } else {
+                SKSE::log::error(
+                    "MST APPEARANCE Override interface version {} is older than the {} this build "
+                    "declares; leaving it disabled for the same reason.",
+                    candidate->GetVersion(),
+                    SKEE::IOverrideInterface::kSupportedVersion);
+            }
         }
         SKSE::log::info(
             "MST APPEARANCE interfaces READY overlay={} overlayVersion={} override={} overrideVersion={} mode=probe+face-material-rebind+pubic-overlay",
diff --git a/src/MorphSyncService.cpp b/src/MorphSyncService.cpp
index 1959ce3..743e9eb 100644
--- a/src/MorphSyncService.cpp
+++ b/src/MorphSyncService.cpp
@@ -150,10 +150,20 @@ namespace MorphSyncTogether
             return;
         }
 
-        _bodyMorph = static_cast<SKEE::IBodyMorphInterface*>(base);
-        SKSE::log::info(
-            "MST RaceMenu BodyMorph interface READY version={}",
-            _bodyMorph->GetVersion());
+        auto* bodyMorph = static_cast<SKEE::IBodyMorphInterface*>(base);
+        const auto bodyMorphVersion = bodyMorph->GetVersion();
+        if (bodyMorphVersion < SKEE::IBodyMorphInterface::kSupportedVersion) {
+            SKSE::log::critical(
+                "MST RaceMenu BodyMorph interface version {} is older than the {} this build "
+                "declares; leaving it disabled because the vtable layout differs. Update RaceMenu.",
+                bodyMorphVersion,
+                SKEE::IBodyMorphInterface::kSupportedVersion);
+        } else {
+            _bodyMorph = bodyMorph;
+            SKSE::log::info(
+                "MST RaceMenu BodyMorph interface READY version={}",
+                _bodyMorph->GetVersion());
+        }
 
         AppearanceProbe::GetSingleton().Initialize(exchange.interfaceMap);
     }
