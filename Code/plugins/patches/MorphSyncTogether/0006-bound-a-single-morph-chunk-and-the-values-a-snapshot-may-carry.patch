diff --git a/src/MorphSyncService.h b/src/MorphSyncService.h
--- a/src/MorphSyncService.h
+++ b/src/MorphSyncService.h
@@ -110,6 +110,21 @@ namespace MorphSyncTogether
         static std::vector<std::string> Split(std::string_view text, char delimiter);
         static std::optional<std::string> ReadField(std::string_view packet, std::string_view key);
 
+        // The chunk count is bounded above, but neither the size of a single
+        // chunk nor the number of morph values a snapshot may carry is: a peer
+        // that ignores the chunker can send chunks of the largest packet the
+        // transport allows, and the apply path then walks every value it holds.
+        // Both are bounded by what this plugin own sender can produce, and the
+        // sender now refuses to exceed the chunk cap it shares with the reader.
+        static constexpr std::size_t kMaxMorphChunkBytes = 4096;
+        static constexpr std::size_t kMaxMorphValues = 4096;
+
+        // The receiver refuses a snapshot split into more than this many chunks,
+        // so the sender has to stay under the same number. Both sides read this
+        // one constant: a sender that exceeds it produces a snapshot that can
+        // never be assembled, and the failure would be silent on the send side.
+        static constexpr std::size_t kMaxMorphChunks = 128;
+
         Config _config{};
         SKEE::IBodyMorphInterface* _bodyMorph{ nullptr };
         bool _initialized{ false };
diff --git a/src/MorphSyncService.cpp b/src/MorphSyncService.cpp
--- a/src/MorphSyncService.cpp
+++ b/src/MorphSyncService.cpp
@@ -582,7 +582,9 @@ namespace MorphSyncTogether
         const auto count = ParseSize(ReadField(payload, "count"));
         const auto props = ReadField(payload, "props");
 
-        if (hash == 0 || !sequence || !count || !props || *count == 0 || *count > 128 || *sequence >= *count) {
+        if (hash == 0 || !sequence || !count || !props || *count == 0 ||
+            *count > kMaxMorphChunks || *sequence >= *count ||
+            props->size() > kMaxMorphChunkBytes) {
             SKSE::log::warn("MST MORPH RX invalid packet sender=\"{}\"", sender);
             return;
         }
