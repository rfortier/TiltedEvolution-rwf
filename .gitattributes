# Auto detect text files and perform LF normalization
* text=auto

# Custom for Visual Studio
*.cs     diff=csharp
# Standard to msysgit
*.doc	 diff=astextplain
*.DOC	 diff=astextplain
*.docx diff=astextplain
*.DOCX diff=astextplain
*.dot  diff=astextplain
*.DOT  diff=astextplain
*.pdf  diff=astextplain
*.PDF	 diff=astextplain
*.rtf	 diff=astextplain
*.RTF	 diff=astextplain

# Custom for the project to build
*.sh text eol=lf

# Byte-stable by contract. The STRPM interface header is pinned by SHA-256 and
# the FOMOD wizard is generated and compared verbatim, so both must check out
# with identical line endings everywhere. Without this, a Windows checkout
# (text=auto + core.autocrlf) reports phantom drift against a pin recorded
# elsewhere, and the gate stops meaning anything.
Code/plugins/STRPM/include/STRPluginMessagingAPI/*.h text eol=lf
Code/plugins/STRPM/contract.json text eol=lf
Code/plugins/plugins.json text eol=lf
GameFiles/Skyrim/fomod/ModuleConfig.xml text eol=lf

# Patches are applied to the submodule working tree with 'git apply', which
# compares context lines byte for byte. A Windows checkout (text=auto +
# core.autocrlf) turns every line into CRLF and the context stops matching, so
# the patch becomes unappliable on exactly the platform CI runs on - measured,
# not assumed: with a CRLF copy, 'verify' failed while 'apply' silently
# succeeded, which is the worst possible split. Pinned to LF for the same
# reason as the two files above.
Code/plugins/patches/**/*.patch text eol=lf

# ...but a patch has to match the endings its own target is *stored* with, and
# the pinned submodules disagree with each other: OstimNG-API-Thread.cpp is
# stored CRLF while Main.cpp and PapyrusThread.h are stored LF. So the LF pin
# above is right for every patch whose targets are LF and wrong for
# OStimNG/0007, which edits the thread file - normalizing it to LF makes
# 'plugin_patches.py verify' (a CI step) fail with "does not apply to the
# pinned commit" on exactly the checkout CI makes. Measured, not assumed: the
# CRLF copy exits 0, the same content with LF context exits 128. Kept
# byte-exact instead, and this line must stay after the pin above, because the
# later rule wins.
Code/plugins/patches/OStimNG/0007-*.patch -text

# Batch files must stay CRLF for cmd.exe
*.bat text eol=crlf
